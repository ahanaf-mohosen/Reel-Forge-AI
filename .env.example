# Copy to .env and fill in your values

# OpenAI
OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/reelforge

# Server
PORT=3000
NODE_ENV=development
SESSION_SECRET=change-this-to-a-long-random-string
APP_URL=http://localhost:3000

# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube OAuth (optional)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# Facebook OAuth (optional)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Support contacts (footer & emails)
SUPPORT_EMAIL=
EMERGENCY_EMAIL=
SUPPORT_HOURS=Mon–Fri, 9 AM – 6 PM (local time)

# Admin (comma-separated emails)
ADMIN_EMAILS=
